     // Real HTML tags always have a letter (optionally after a `/`) immediately
     // after `<` — `<x>`, `</div>`, `<br/>`. This deliberately does NOT match
     // `<[^>]*>` generically: once flattenTokenText() started handing back
     // unescaped plain text (v3.4.0 §1), literal author text like "C < D > E"
     // would otherwise look like a tag and get silently eaten here.
+    //
+    // HTML comments (`<!-- ... -->`) don't start with a letter either, so they
+    // need their own alternative — without it a heading like
+    // "## Section <!-- note --> Title" leaks "note" into the slug
+    // (v3.4.0 Task 1 fix round 1). Known gap, deliberately left open: this
+    // does NOT special-case `<!DOCTYPE ...>` or `<? ... ?>` (processing
+    // instructions) — same non-letter-after-`<` shape, but neither has shown
+    // up in a real heading/prose fixture. Add an alternative here if one does.
     function stripHtmlTags(value) {
-      return String(value || '').replace(/<\/?[a-zA-Z][^<>]*>/g, '');
+      return String(value || '').replace(/<!--[\s\S]*?-->|<\/?[a-zA-Z][^<>]*>/g, '');
     }
 
     function slugifyHeading(value) {
       const base = stripHtmlTags(value)
         .normalize('NFKD')
         .replace(/[\u0300-\u036f]/g, '')
         .trim()
         .toLowerCase()
         .replace(/[^a-z0-9\u4e00-\u9fff]+/g, '-')
         .replace(/^-+|-+$/g, '')
