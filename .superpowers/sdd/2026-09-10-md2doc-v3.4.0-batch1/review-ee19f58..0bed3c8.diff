+  // v3.4.0 / backlog 3 (Ruling T6-7): STRONG and EM each emit a fixed,
+  // context-blind '*'-based delimiter for their own tag — '**'/'**' or
+  // '*'/'*' — with no awareness of what character the accumulated sibling
+  // output already ends with. CommonMark scans the *raw character stream*,
+  // not the DOM/AST, and a "delimiter run" is defined as a maximal span of
+  // identical adjacent characters: when one node's closing '*' is directly
+  // followed (no separating character) by the next sibling's opening '*',
+  // the two independent single-char delimiter EVENTS silently fuse into one
+  // length-2+ RUN in the emitted text, which marked's own flanking/pairing
+  // algorithm then matches on its own terms — not necessarily the pairing
+  // the DOM implied. Measured (task-8 report has the exact bytes): DOM
+  // `<em><code>code</code></em><em>text</em>` serializes to
+  // `*`code`**text*` — the merged `**` is grabbed by marked as its own
+  // delimiter run, and the FIRST <em> is dropped entirely, reappearing as
+  // two literal '*' characters around the code span on reload.
+  // Fix: before a STRONG/EM node emits its own leading '*'/'**', check
+  // whether the sibling-level accumulator already ends in '*'; if so,
+  // splice in an empty HTML comment as a run-breaker. `<!-- -->` contains
+  // no '*', so it always ends the preceding run and starts a fresh one for
+  // this node, regardless of what character sits on either side of it —
+  // unlike switching to `_`/`__`, which was tried and rejected: `_`-based
+  // emphasis carries CommonMark's intraword restriction, and a switched
+  // closing `_` immediately glued to a following word character (no space)
+  // fails to close at all (verified: `*`code`*_text_word` leaves
+  // `_text_word` unparsed, while the HTML-comment form parses `text` as EM
+  // in the same shape). The comment is inert on read-back too: `walkChildren`
+  // only handles nodeType 3 (text) and 1 (element) and silently skips
+  // anything else (comment nodes are nodeType 8), so it never leaks into
+  // canWysiwyg's `unsupported` list or into a later re-serialize — a
+  // reparsed document with the comment still in the DOM just re-triggers
+  // this same guard on the next save, it does not accumulate.
+  //
+  // TRAILING_LIVE_STAR distinguishes a live, still-scannable trailing '*'
+  // from one that CommonMark's own backslash-escape rule has already
+  // removed from delimiter-run consideration. escapeText() unconditionally
+  // escapes every literal '*' a user types, so a text node ending in one
+  // literal asterisk emits "...\*", not "...*" — e.g. the text "a*" (typed
+  // literally, no italics intent) immediately followed by an EM. A naive
+  // last-char check (`out.charAt(out.length-1) === '*'`) can't tell this
+  // apart from the real bug: it sees "a\*" ends in '*' and inserts a
+  // needless `<!-- -->`, even though "a\*<em>x</em>" already round-trips
+  // correctly on its own (marked.parseInline gives "a*<em>x</em>" — the
+  // escaped star and the EM never merge, because the backslash already took
+  // the star out of delimiter-run scanning). This false trigger is, if
+  // anything, MORE common in practice than the real bug: typing a literal
+  // '*' right before toggling italics on the next word is an everyday
+  // gesture, two marks landing DOM-adjacent is not. The regex requires the
+  // trailing '*' to be preceded by an EVEN number of backslashes (0, 2, 4,
+  // ...) — each PAIR of backslashes is
+  // itself one escaped, literal backslash character, so an even count in
+  // front of the '*' leaves the '*' itself unescaped and live; an odd count
+  // means the last backslash belongs to the '*', escaping it. Matched
+  // against the end of the string only (`$`), so this is O(1) amortized in
+  // practice for the short runs that actually occur here — it does not need
+  // to rescan the whole accumulated `out` string, just its tail.
+  var TRAILING_LIVE_STAR = /(?:^|[^\\])(?:\\\\)*\*$/;
+  function starBoundaryGuard(out) {
+    return TRAILING_LIVE_STAR.test(out) ? '<!-- -->' : '';
+  }
