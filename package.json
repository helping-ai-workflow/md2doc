{
  "name": "@helping-ai-workflow/md2doc",
  "version": "2.6.1",
  "description": "Markdown → HTML / PDF renderer with WaveDrom, Mermaid, and Graphviz support",
  "keywords": [
    "markdown",
    "html",
    "pdf",
    "renderer",
    "wavedrom",
    "mermaid",
    "graphviz"
  ],
  "main": "lib/md2doc.js",
  "bin": {
    "md2doc": "bin/md2doc.js"
  },
  "files": [
    "lib/",
    "bin/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hpcc-js/wasm-graphviz": "1.22.0",
    "katex": "^0.16.47",
    "marked": "^14.1.0",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "11.15.0",
    "puppeteer": "^24.15.0",
    "wavedrom": "3.5.0"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall.js",
    "test": "node test/md2doc.test.js && node test/images.test.js && node test/scroll-anchor.test.js && node test/lightbox.test.js && node test/reader-panels.test.js && node test/cli.test.js && node test/code-operator.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helping-ai-workflow/md2doc.git"
  },
  "homepage": "https://github.com/helping-ai-workflow/md2doc#readme",
  "bugs": "https://github.com/helping-ai-workflow/md2doc/issues",
  "author": "helping-ai-workflow",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
